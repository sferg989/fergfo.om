import { PreferredStocks } from '../enums/preferredStocks';
import StockOptionsSection from './stock_options_section.astro';
import { OptionsService } from '../services/optionsService';
import { OptionScorer } from '../utils/optionScorer';
import { ReturnCalculator } from '../utils/returnCalculator';
import type { ScoredOption, StockSectionData } from '../types/option';
import '../styles/optionsTable.css';

const DAY_MS = 1000 * 60 * 60 * 24;
const symbols = Object.values(PreferredStocks);
const db = (Astro.locals.runtime?.env?.DB as D1Database) || null;

const emptySection = (symbol: string, error: string): StockSectionData => ({
  symbol,
  currentPrice: 0,
  topOptions: [],
  highestScore: 0,
  bestAnnualizedPremium: 0,
  error,
});

async function loadSection(optionsService: OptionsService, symbol: string): Promise<StockSectionData> {
  const rawData = await optionsService.fetchOptionsData(symbol);
  if (rawData.error) {return emptySection(symbol, rawData.error);}

  const scoredOptions: ScoredOption[] = rawData.options
    .map(option => ({
      ...option,
      score: OptionScorer.calculateScore(option, rawData.currentPrice, rawData.realizedVol, rawData.earningsDates),
    }))
    .sort((a, b) => b.score.total - a.score.total);

  const highestScore = scoredOptions.length > 0 ? scoredOptions[0].score.total : 0;
  // All options sharing the highest score (small epsilon for float comparison)
  const topOptions = scoredOptions.filter(option => Math.abs(option.score.total - highestScore) < 0.01);
  const bestAnnualizedPremium = Math.max(0, ...topOptions.map(option =>
    ReturnCalculator.calculateAnnualizedReturn({
      premium: option.bid,
      strike: option.strike,
      daysToExpiry: Math.ceil((new Date(option.expirationDate).getTime() - Date.now()) / DAY_MS),
      marginRate: 1,
    })
  ));

  return { symbol, currentPrice: rawData.currentPrice, topOptions, highestScore, bestAnnualizedPremium };
}

let sections: StockSectionData[];

if (db) {
  const optionsService = OptionsService.getInstance(db);
  const results = await Promise.allSettled(symbols.map(symbol => loadSection(optionsService, symbol)));
  sections = results.map((result, index) => {
    if (result.status === 'fulfilled') {return result.value;}
    console.error(`Error fetching options for ${symbols[index]}:`, result.reason);
    return emptySection(
      symbols[index],
      result.reason instanceof Error ? result.reason.message : 'Unknown error fetching data'
    );
  });
} else {
  sections = symbols.map(symbol => emptySection(symbol, 'Database not available'));
}

// Best score first; equal scores ranked by the annualized premium of their top option
sections.sort((a, b) =>
  b.highestScore - a.highestScore || b.bestAnnualizedPremium - a.bestAnnualizedPremium
);
---

<div class="preferred-stocks-container">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">Preferred Stocks Top Scoring Options</h1>
  </div>

  <div class="grid gap-8" id="stocks-container">
    {sections.map((section) => <StockOptionsSection {...section} />)}
  </div>
</div>

